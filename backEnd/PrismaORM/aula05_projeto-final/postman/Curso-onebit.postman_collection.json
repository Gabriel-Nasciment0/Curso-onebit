                        "type": "text/javascript",
                        "exec": [
                            "const runId = `${Date.now()}-${Math.floor(Math.random() * 100000)}`;",
                            "pm.collectionVariables.set('runId', runId);",
                            "pm.collectionVariables.set('leadId', '');",
                            "pm.collectionVariables.set('groupId', '');",
                            "pm.collectionVariables.set('campaignId', '');",
                            "pm.collectionVariables.set('leadName', `Postman_Lead_${runId}`);",
                            "pm.collectionVariables.set('leadEmail', `postman-${runId}@example.com`);",
                            "pm.collectionVariables.set('groupName', `Postman Group ${runId}`);",
                            "pm.collectionVariables.set('campaignName', `Postman Campaign ${runId}`);"
                        ]
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Retorna status da API', function () {",
                            "    pm.response.to.have.status(200);",
                            "    pm.expect(pm.response.json()).to.deep.equal({ message: 'OK' });",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/status"
            }
        },
